# Salin file ini menjadi .env.local (atau isi saat build) sebelum publikasi.
# Kosongkan untuk memakai placeholder [URL_WEB_APP] dan [URL_APK].

# URL aplikasi web Gerakin yang sudah berjalan.
# Contoh: VITE_WEB_APP_URL=https://app.gerakin.id/
VITE_WEB_APP_URL=

# URL file APK setelah tersedia. Jangan lupa set APK_AVAILABLE = true di src/data.ts.
VITE_APK_URL=
